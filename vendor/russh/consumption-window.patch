+    pub(crate) fn consume_receive_window(&mut self, id: ChannelId, bytes: usize) -> Result<(), crate::Error> {
+        if let Some(channel) = self.channels.get_mut(&id) {
+            if bytes > channel.sender_window_size as usize
+                || bytes > channel.sender_maximum_packet_size as usize {
+                return Err(crate::Error::Inconsistent);
+            }
+            channel.sender_window_size -= bytes as u32;
+        }
+        Ok(())
+    }
+
+    pub(crate) fn replenish_receive_window(&mut self, id: ChannelId, bytes: u32) -> Result<(), crate::Error> {
+        if let Some(channel) = self.channels.get_mut(&id) {
+            if !channel.confirmed { return Ok(()); }
+            channel.sender_window_size = channel.sender_window_size.checked_add(bytes)
+                .ok_or(crate::Error::Inconsistent)?;
+            push_packet!(self.write, {
+                self.write.push(msg::CHANNEL_WINDOW_ADJUST);
+                channel.recipient_channel.encode(&mut self.write)?;
+                bytes.encode(&mut self.write)?;
+            });
+        }
+        Ok(())
+    }
