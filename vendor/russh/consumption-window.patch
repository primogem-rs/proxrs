+/// Consumption credit for an opt-in direct-tcpip receive window.
+/// Notifications coalesce; the counter cannot exceed the advertised window.
+#[derive(Debug)]
+pub(crate) struct ReceiveCredit {
+    pub(crate) consumed: AtomicU32,
+    pub(crate) control_seen: AtomicU8,
+    pub(crate) notify: Arc<Notify>,
+}
+
+impl ReceiveCredit {
+    pub(crate) fn new(notify: Arc<Notify>) -> Arc<Self> {
+        Arc::new(Self {
+            consumed: AtomicU32::new(0),
+            control_seen: AtomicU8::new(0),
+            notify,
+        })
+    }
+
+    pub(crate) fn release(&self, bytes: usize) {
+        if bytes != 0 {
+            // Bytes originated in a u32 SSH receive window.
+            self.consumed.fetch_add(bytes as u32, Ordering::AcqRel);
+            self.notify.notify_one();
+        }
+    }
+}
